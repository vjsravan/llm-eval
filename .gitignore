__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/
.DS_Store

# Generated runs are disposable — except the baseline, which IS the gate's reference
# point and has to be in the repo. Ignoring all of runs/ is why CI never had one to
# compare against, so the statistical half of the gate silently never ran.
runs/*
!runs/baseline.json
